# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lifeflow?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_8_chars
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS and cookie origin)
CLIENT_URL=http://localhost:3000

# AI Provider Configuration (OpenAI-compatible)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=your_openai_or_groq_or_compatible_api_key
AI_MODEL=gpt-4o-mini

